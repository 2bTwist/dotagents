.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Local test-freeze unlock sentinel. Must never be committed: a committed
# unlock silently disables the freeze for everyone who clones.
.claude/tests-unlocked

# Machine-specific instruction references. instructions/core.md refers to these
# by role, never by path, so the shared document stays publishable and the
# specifics stay on the machine. See instructions/references/README.md.
instructions/references/*.local.md
